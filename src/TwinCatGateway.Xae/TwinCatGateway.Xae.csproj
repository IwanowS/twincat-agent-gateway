<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Description>TwinCAT XAE COM boundary, hosted only by the desktop gateway.</Description>
    <TwinCatXaeBaseVersion Condition="'$(TwinCatXaeBaseVersion)' == ''">3.1</TwinCatXaeBaseVersion>
    <TwinCatXaeBaseInteropPath>$(MSBuildThisFileDirectory)..\..\lib\interop\twincat-xae-base\$(TwinCatXaeBaseVersion)\Interop.TCatSysManagerLib.dll</TwinCatXaeBaseInteropPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Interop.TCatSysManagerLib">
      <HintPath>$(TwinCatXaeBaseInteropPath)</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EnvDTE" />
    <PackageReference Include="EnvDTE80" />
    <PackageReference Include="Microsoft.VisualStudio.Interop" />
    <ProjectReference Include="..\TwinCatGateway.Contracts\TwinCatGateway.Contracts.csproj" />
    <ProjectReference Include="..\TwinCatGateway.Core\TwinCatGateway.Core.csproj" />
  </ItemGroup>

  <Target Name="ValidateTwinCatXaeBaseInterop" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(TwinCatXaeBaseInteropPath)')"
      Text="TwinCAT XAE Base interop version '$(TwinCatXaeBaseVersion)' is unavailable. Expected '$(TwinCatXaeBaseInteropPath)'." />
  </Target>
</Project>
