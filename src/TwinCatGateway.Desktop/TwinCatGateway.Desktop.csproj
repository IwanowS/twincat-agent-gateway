<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>twincat-gateway</AssemblyName>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <Description>Interactive x86 desktop host for the TwinCAT XAE gateway.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TwinCatGateway.Ads\TwinCatGateway.Ads.csproj" />
    <ProjectReference Include="..\TwinCatGateway.Contracts\TwinCatGateway.Contracts.csproj" />
    <ProjectReference Include="..\TwinCatGateway.Core\TwinCatGateway.Core.csproj" />
    <ProjectReference Include="..\TwinCatGateway.Ipc\TwinCatGateway.Ipc.csproj" />
    <ProjectReference Include="..\TwinCatGateway.Xae\TwinCatGateway.Xae.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon.ico"
              Link="Assets\icon.ico" />
    <None Include="..\..\setup\SETUP_INSTRUCTIONS.txt"
          Link="SETUP_INSTRUCTIONS.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\CONFIGURATION.md"
          Link="CONFIGURATION.md"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
