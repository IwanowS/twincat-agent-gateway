<Window x:Class="TwinCatGateway.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TwinCAT Agent Gateway"
        Width="920"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#17212B"
                           Text="TwinCAT Agent Gateway" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="#5C6975"
                           Text="{Binding Solution}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="14,8"
                    Background="#E2EAF2"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="#405366"
                               Text="Gateway  " />
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#17212B"
                               Text="{Binding GatewayState}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,22,0,0"
                Padding="18"
                Background="White"
                BorderBrush="#DCE2E8"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#6A7681"
                               Text="XAE session" />
                    <TextBlock Margin="0,5,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding XaeStatus}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Foreground="#6A7681"
                               Text="Profile" />
                    <TextBlock Margin="0,5,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding Profile}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Foreground="#6A7681"
                               Text="Current operation" />
                    <TextBlock Margin="0,5,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentOperation}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="18"
                Background="White"
                BorderBrush="#DCE2E8"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Foreground="#6A7681"
                           Text="Activation safety" />
                <TextBlock Margin="0,5,0,0"
                           FontWeight="SemiBold"
                           Text="{Binding ActivationPolicy}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#5C6975"
                           Text="{Binding Target}" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="#B42318"
                           TextWrapping="Wrap"
                           Text="{Binding StartupError}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="18"
                Background="White"
                BorderBrush="#DCE2E8"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,10"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="Recent operations" />
                <ListView x:Name="RecentOperationsList"
                          ItemsSource="{Binding RecentOperations}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="150"
                                            DisplayMemberBinding="{Binding QueuedAt}"
                                            Header="Queued" />
                            <GridViewColumn Width="130"
                                            DisplayMemberBinding="{Binding Kind}"
                                            Header="Operation" />
                            <GridViewColumn Width="120"
                                            DisplayMemberBinding="{Binding State}"
                                            Header="State" />
                            <GridViewColumn Width="360"
                                            DisplayMemberBinding="{Binding OperationId}"
                                            Header="Operation ID" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="#6A7681"
                       Text="{Binding LogDirectory}" />
            <Button Grid.Column="1"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Click="RefreshButton_Click"
                    Content="Refresh" />
            <Button Grid.Column="2"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Click="OpenOperationLogButton_Click"
                    Content="View selected log" />
            <Button Grid.Column="3"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Click="OpenLogsButton_Click"
                    Content="Open logs" />
        </Grid>
    </Grid>
</Window>
