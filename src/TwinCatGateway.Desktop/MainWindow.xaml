<Window x:Class="TwinCatGateway.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TwinCAT Agent Gateway"
        Width="1080"
        Height="780"
        MinWidth="880"
        MinHeight="650"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#17212B"
                               Text="TwinCAT Agent Gateway" />
                    <TextBlock Margin="12,9,0,0"
                               FontSize="13"
                               Foreground="#6A7681"
                               Text="{Binding Version}" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="#5C6975"
                           Text="{Binding Solution}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="14,8"
                    Background="#E2EAF2"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="#405366"
                               Text="Gateway  " />
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#17212B"
                               Text="{Binding GatewayState}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,22,0,0"
                Padding="18"
                Background="White"
                BorderBrush="#DCE2E8"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#6A7681"
                               Text="XAE session" />
                    <TextBlock Margin="0,5,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding XaeStatus}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Foreground="#6A7681"
                               Text="Profile" />
                    <TextBlock Margin="0,5,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding Profile}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Foreground="#6A7681"
                               Text="Current operation" />
                    <TextBlock Margin="0,5,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentOperation}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="18"
                Background="White"
                BorderBrush="#DCE2E8"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#6A7681"
                               Text="Activation safety" />
                    <TextBlock Margin="0,5,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding ActivationPolicy}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#5C6975"
                               Text="{Binding Target}" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               Text="{Binding StartupError}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Foreground="#6A7681"
                               Text="Workspace ownership" />
                    <TextBlock Margin="0,5,0,0"
                               FontWeight="SemiBold"
                               Foreground="#5C6975"
                               TextWrapping="Wrap"
                               Text="{Binding WorkspaceOwnership}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="18"
                Background="White"
                BorderBrush="#DCE2E8"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#6A7681"
                               Text="Progress stage" />
                    <TextBlock Margin="0,5,12,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding CurrentStage}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Foreground="#6A7681"
                               Text="Last build" />
                    <TextBlock Margin="0,5,12,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding LastBuild}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Foreground="#6A7681"
                               Text="Last activation" />
                    <TextBlock Margin="0,5,12,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding LastActivation}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Foreground="#6A7681"
                               Text="Last TcUnit run" />
                    <TextBlock Margin="0,5,0,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding LastTest}" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="4"
                            Margin="0,14,0,0">
                    <TextBlock Foreground="#6A7681"
                               Text="Latest diagnostic issue" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               Text="{Binding LastIssue}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="18"
                Background="White"
                BorderBrush="#DCE2E8"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,10"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="Recent operations" />
                <ListView x:Name="RecentOperationsList"
                          ItemsSource="{Binding RecentOperations}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="150"
                                            DisplayMemberBinding="{Binding QueuedAt}"
                                            Header="Queued" />
                            <GridViewColumn Width="130"
                                            DisplayMemberBinding="{Binding Kind}"
                                            Header="Operation" />
                            <GridViewColumn Width="120"
                                            DisplayMemberBinding="{Binding State}"
                                            Header="State" />
                            <GridViewColumn Width="360"
                                            DisplayMemberBinding="{Binding OperationId}"
                                            Header="Operation ID" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <Grid Grid.Row="5"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="#6A7681"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding LogDirectory}" />
            <Button Grid.Column="1"
                    MinWidth="92"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    IsEnabled="{Binding CanReconnect}"
                    Click="ReconnectButton_Click"
                    Content="Reconnect" />
            <Button Grid.Column="2"
                    MinWidth="92"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Click="RefreshButton_Click"
                    Content="Refresh" />
            <Button Grid.Column="3"
                    MinWidth="124"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Click="SetupInstructionsButton_Click"
                    Content="Setup instructions" />
            <StackPanel Grid.Column="4"
                        Margin="8,0,0,0"
                        Orientation="Horizontal">
                <ComboBox Width="92"
                          Margin="0,0,6,0"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding BuildActions}"
                          SelectedItem="{Binding SelectedBuildAction}" />
                <Button MinWidth="82"
                        Padding="12,7"
                        IsEnabled="{Binding CanStartOperation}"
                        Click="BuildButton_Click"
                        Content="Run build" />
                <Button MinWidth="82"
                        Margin="6,0,0,0"
                        Padding="12,7"
                        IsEnabled="{Binding CanSynchronize}"
                        Click="SynchronizeButton_Click"
                        Content="Sync disk" />
                <Button MinWidth="92"
                        Margin="6,0,0,0"
                        Padding="12,7"
                        IsEnabled="{Binding CanActivate}"
                        Click="ActivateButton_Click"
                        Content="Activate…" />
                <Button MinWidth="104"
                        Margin="6,0,0,0"
                        Padding="12,7"
                        Click="OpenOperationLogButton_Click"
                        Content="View log" />
                <Button MinWidth="92"
                        Margin="6,0,0,0"
                        Padding="12,7"
                        Click="OpenLogsButton_Click"
                        Content="Open logs" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
