					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="PrivateKey"/>
				<xs:attribute name="PrivateKeyEncrypted"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="DataAreaType">
		<xs:sequence>
