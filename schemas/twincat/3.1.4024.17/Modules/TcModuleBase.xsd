<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:simpleType name="GUID">
		<xs:restriction base="xs:string">
			<xs:pattern value="\{[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="LibraryId">
		<xs:annotation>
			<xs:documentation>vendor, library name and version: 'vendor'|'name'|d.d.d.d</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="([0-9a-zA-Z_ ]){1,}\|([0-9a-zA-Z_ ]){1,}\|([0-9]){1,}\.([0-9]){1,}\.([0-9]){1,}\.([0-9]){1,}"/>
			<xs:pattern value="([0-9a-zA-Z_ ]){1,}\|([0-9a-zA-Z_ ]){1,}\|\*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UniqueName">
		<xs:restriction base="xs:string">
			<xs:pattern value="([0-9a-zA-Z_#@()])*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SeverityType">
		<xs:restriction base="xs:NMTOKEN">
			<xs:enumeration value="Verbose"/>
			<xs:enumeration value="Info"/>
			<xs:enumeration value="Warning"/>
			<xs:enumeration value="Error"/>
			<xs:enumeration value="Critical"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="HexDecValue">
		<xs:restriction base="xs:string">
			<xs:pattern value="[+-]?[0-9]{1,}"/>
			<xs:pattern value="#x[0-9|a-f|A-F]{1,}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="HexDecGuidValue">
		<xs:restriction base="xs:string">
			<xs:pattern value="[+-]?[0-9]{1,}"/>
			<xs:pattern value="#x[0-9|a-f|A-F]{1,}"/>
			<xs:pattern value="\{[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="HexDecFloatValue">
		<xs:restriction base="xs:string">
			<xs:pattern value="[+-]?[0-9]{1,}"/>
			<xs:pattern value="[+-]?[0-9]{1,}[eE][+-][0-9]{1,}"/>
			<xs:pattern value="[+-]?[0-9]*.[0-9]{1,}"/>
			<xs:pattern value="[+-]?[0-9]{1,}.[0-9]*"/>
			<xs:pattern value="[+-]?[0-9]{1,}.[0-9]*[eE][+-][0-9]{1,}"/>
			<xs:pattern value="#x[0-9|a-f|A-F]{1,}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DateTimeValue">
		<xs:restriction base="xs:string">
			<xs:pattern value="(TIME|LTIME|T|LT)#[+-]?([0-9]{1,}(.[0-9]{1,})?(D|d))?([0-9]{1,}(.[0-9]{1,})?(H|h))?([0-9]{1,}(.[0-9]{1,})?(M|m))?([0-9]{1,}(.[0-9]{1,})?(S|s))?"/>
			<xs:pattern value="(TIME_OF_DAY|LTIME_OF_DAY|TOD|LTOD)#[0-9]{1,}:[0-9]{1,}:[0-9]{1,}(.[0-9]{1,})?"/>
			<xs:pattern value="(DATE|LDATE|D|LD)#[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}"/>
			<xs:pattern value="(DATE_AND_TIME|LDATE_AND_TIME|DT|LDT)#[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}-[0-9]{1,}:[0-9]{1,2}:[0-9]{1,2}(.[0-9]{1,})?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GenericDataType">
		<xs:restriction base="xs:NMTOKEN">
			<xs:enumeration value="BYTE"/>
			<xs:enumeration value="WORD"/>
			<xs:enumeration value="DWORD"/>
			<xs:enumeration value="LWORD"/>
			<xs:enumeration value="SINT"/>
			<xs:enumeration value="INT"/>
			<xs:enumeration value="DINT"/>
			<xs:enumeration value="LINT"/>
			<xs:enumeration value="USINT"/>
			<xs:enumeration value="UINT"/>
			<xs:enumeration value="UDINT"/>
			<xs:enumeration value="ULINT"/>
			<xs:enumeration value="REAL"/>
			<xs:enumeration value="LREAL"/>
			<xs:enumeration value="STRING"/>
			<xs:enumeration value="OTCID"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="LangTextType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="TxtId">
					<xs:annotation>
						<xs:documentation>a reference to the translations section (if empty the actual text is used as a reference</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="ArrayInfoType">
		<xs:sequence>
			<xs:element name="LBound">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:integer">
							<xs:attribute name="Constant" type="GUID">
								<xs:annotation>
									<xs:documentation>LBound depend on actual value of constant</xs:documentation>
								</xs:annotation>
							</xs:attribute>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="Elements">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:integer">
							<xs:attribute name="Min" type="xs:integer"/>
							<xs:attribute name="Max" type="xs:integer"/>
							<xs:attribute name="MaxUnbounded" type="xs:boolean"/>
							<xs:attribute name="Constant" type="GUID">
								<xs:annotation>
									<xs:documentation>Elements depend on actual value of constant</xs:documentation>
								</xs:annotation>
							</xs:attribute>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="Level" type="xs:integer">
			<xs:annotation>
				<xs:documentation>ARRAY [] OF ARRAY [] level</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="PointerTo">
			<xs:annotation>
				<xs:documentation>0 = Normal type; 1 = POINTER TO; 2 = POINTER TO POINTER TO; 3 = POINTER TO POINTER TO POINTER TO</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:int">
					<xs:minInclusive value="0"/>
					<xs:maxInclusive value="3"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="ReferenceTo" type="xs:boolean"/>
	</xs:complexType>
	<xs:complexType name="EnumInfoType">
		<xs:sequence>
			<xs:element name="Text" type="LangTextType"/>
			<xs:element name="Enum" type="HexDecValue" minOccurs="0"/>
			<xs:element name="Comment" type="LangTextType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PropertyType">
		<xs:sequence>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="Value" type="xs:string" minOccurs="0"/>
			<xs:element name="Desc" type="LangTextType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SubItemType">
		<xs:sequence>
			<xs:element name="Name">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="SubIdx" type="HexDecValue"/>
							<xs:attribute name="HideSubItems" type="xs:boolean"/>
							<xs:attribute name="Static" type="xs:boolean">
								<xs:annotation>
									<xs:documentation>Static subitem has no BitOffs . Reference to a symbol with 'DataType.Name'.'SubItem.Name'</xs:documentation>
								</xs:annotation>
							</xs:attribute>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="DisplayName" type="LangTextType" minOccurs="0"/>
			<xs:element name="Type" type="TypeType"/>
			<xs:choice>
				<xs:element name="ArrayInfo" type="ArrayInfoType" minOccurs="0" maxOccurs="3"/>
				<xs:element name="EnumInfo" type="EnumInfoType" maxOccurs="unbounded"/>
			</xs:choice>
			<xs:element name="Comment" type="LangTextType" minOccurs="0"/>
			<xs:element name="BitSize" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Will be calculated automatically if not present</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:long">
							<xs:attribute name="X64" type="xs:long"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="BitOffs" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Will be calculated automatically if not present</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:long">
							<xs:attribute name="X64" type="xs:long"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="Unit" type="LangTextType" minOccurs="0"/>
			<xs:element name="Default" type="DefaultType" minOccurs="0"/>
			<xs:element name="Properties" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Property" type="PropertyType" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Xml" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:any namespace="##any" processContents="skip" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EventIdType">
		<xs:sequence>
			<xs:element name="Name">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="Id" type="HexDecValue" use="required"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="DisplayName" type="LangTextType" minOccurs="0"/>
			<xs:element name="DescriptionText" type="LangTextType" minOccurs="0"/>
			<xs:element name="DescriptionUrl" type="LangTextType" minOccurs="0"/>
			<xs:element name="Severity" type="SeverityType" minOccurs="0"/>
			<xs:element name="CauseRemedy" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Cause" type="LangTextType" minOccurs="0"/>
						<xs:element name="Remedy" type="LangTextType" minOccurs="0"/>
					</xs:sequence>
					<xs:attribute name="Idx" type="HexDecValue"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="Comment" type="LangTextType" minOccurs="0"/>
			<xs:element name="Properties" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Property" type="PropertyType" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Xml" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:any namespace="##any" processContents="skip" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DataTypeType">
		<xs:sequence>
			<xs:element name="Name">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="GUID" type="GUID">
								<xs:annotation>
									<xs:documentation>Will be generated if not set</xs:documentation>
								</xs:annotation>
							</xs:attribute>
							<xs:attribute name="Namespace" type="xs:string"/>
							<xs:attribute name="GlobalType" type="xs:boolean"/>
							<xs:attribute name="TcBaseType" type="xs:boolean">
								<xs:annotation>
									<xs:documentation>Used to load type independent from any reference</xs:documentation>
								</xs:annotation>
							</xs:attribute>
							<xs:attribute name="IecBaseType" type="xs:boolean"/>
							<xs:attribute name="IecLibraryType" type="xs:boolean"/>
							<xs:attribute name="SignedValue" type="xs:boolean"/>
							<xs:attribute name="Hexadecimal" type="xs:boolean"/>
							<xs:attribute name="FloatingPoint" type="xs:boolean"/>
							<xs:attribute name="StringType" type="xs:boolean"/>
							<xs:attribute name="WStringType" type="xs:boolean"/>
							<xs:attribute name="BitType" type="xs:boolean"/>
							<xs:attribute name="PersistentType" type="xs:boolean"/>
							<xs:attribute name="AutoDeleteType" type="xs:boolean"/>
							<xs:attribute name="OversampleType" type="xs:boolean"/>
							<xs:attribute name="LegacyVType" type="xs:int"/>
							<xs:attribute name="HideType" type="xs:boolean"/>
							<xs:attribute name="HideSubItems" type="xs:boolean"/>
							<xs:attribute name="CName" type="xs:string"/>
							<xs:attribute name="CNameX64" type="xs:string"/>
							<xs:attribute name="IecDeclaration" type="xs:string"/>
							<xs:attribute name="IecDeclarationX64" type="xs:string"/>
							<xs:attribute name="RemovableEnumPrefix" type="xs:string"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="DisplayName" type="LangTextType" minOccurs="0"/>
			<xs:element name="Comment" type="LangTextType" minOccurs="0"/>
			<xs:element name="BitSize" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Will be calculated automatically if not present</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:long">
							<xs:attribute name="X64" type="xs:long"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:choice>
				<xs:sequence>
					<xs:element name="BaseType" type="TypeType"/>
					<xs:choice>
						<xs:element name="ArrayInfo" type="ArrayInfoType" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element name="EnumInfo" type="EnumInfoType" maxOccurs="unbounded"/>
						<xs:element name="FunctionPointer">
							<xs:annotation>
								<xs:documentation>If present, indicates a function pointer type; BaseType must be PVOID or PVOID64</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ReturnType" type="TypeType" minOccurs="0"/>
									<xs:element name="Parameter" type="FuncParaType" minOccurs="0" maxOccurs="unbounded"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:choice>
					<xs:element name="Unit" type="LangTextType" minOccurs="0"/>
				</xs:sequence>
				<xs:element name="EventId" type="EventIdType" minOccurs="0" maxOccurs="unbounded"/>
				<xs:sequence>
					<xs:element name="ExtendsType" minOccurs="0">
						<xs:complexType>
							<xs:simpleContent>
								<xs:extension base="xs:string">
									<xs:attribute name="GUID" type="GUID">
										<xs:annotation>
											<xs:documentation>optional if "ExtendsType" is unambiguous inside this document </xs:documentation>
										</xs:annotation>
									</xs:attribute>
									<xs:attribute name="Namespace" type="xs:string"/>
								</xs:extension>
							</xs:simpleContent>
						</xs:complexType>
					</xs:element>
					<xs:element name="Implements" minOccurs="0" maxOccurs="unbounded">
						<xs:complexType>
							<xs:simpleContent>
								<xs:extension base="xs:string">
									<xs:attribute name="GUID" type="GUID">
										<xs:annotation>
											<xs:documentation>optional if "Implements" is unambiguous inside this document </xs:documentation>
										</xs:annotation>
									</xs:attribute>
									<xs:attribute name="Namespace" type="xs:string"/>
								</xs:extension>
							</xs:simpleContent>
						</xs:complexType>
					</xs:element>
					<xs:element name="SubItem" type="SubItemType" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element name="PropertyItem" type="PropertyItemType" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element name="Action" minOccurs="0" maxOccurs="unbounded">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="Name" type="xs:string"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
				<xs:element name="ArraySubItems">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="LBound" type="xs:int" minOccurs="0">
								<xs:annotation>
									<xs:documentation>default: 0</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:choice>
								<xs:element name="ItemCategory" type="xs:string"/>
								<xs:element name="ItemType" type="TypeType" maxOccurs="unbounded"/>
							</xs:choice>
							<xs:element name="SubItem" minOccurs="0" maxOccurs="unbounded">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="TypeType">
											<xs:attribute name="FixedItem" type="xs:boolean"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
						<xs:attribute name="Min" type="xs:integer"/>
						<xs:attribute name="Max" type="xs:integer"/>
						<xs:attribute name="MaxUnbounded" type="xs:boolean"/>
					</xs:complexType>
				</xs:element>
			</xs:choice>
			<xs:element name="Method" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>If present, indicates an interface type or a FunctionBlock declaration</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Name">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="IecDeclaration" type="xs:string"/>
										<xs:attribute name="PropertyType">
											<xs:simpleType>
												<xs:restriction base="xs:NMTOKEN">
													<xs:enumeration value="none"/>
													<xs:enumeration value="get"/>
													<xs:enumeration value="set"/>
													<xs:enumeration value="getarray"/>
													<xs:enumeration value="setarray"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="RpcEnable">
											<xs:simpleType>
												<xs:restriction base="xs:NMTOKEN">
													<xs:enumeration value="none"/>
													<xs:enumeration value="cpp"/>
													<xs:enumeration value="plc"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
										<xs:attribute name="RpcCallUnlocked" type="xs:boolean"/>
										<xs:attribute name="VTableIndex" type="xs:int"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="Comment" type="LangTextType" minOccurs="0"/>
						<xs:element name="ReturnType" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="TypeType">
										<xs:attribute name="RpcDirection">
											<xs:simpleType>
												<xs:restriction base="xs:NMTOKEN">
													<xs:enumeration value="none"/>
													<xs:enumeration value="out"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:attribute>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="ReturnArrayInfo" type="ArrayInfoType" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Only used for PLC calling convention</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ReturnBitSize" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Will be calculated automatically if not present</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:long">
										<xs:attribute name="X64" type="xs:long"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="Parameter" type="FuncParaType" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element name="Local" type="FuncParaType" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element name="Properties" minOccurs="0">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Property" type="PropertyType" minOccurs="0" maxOccurs="unbounded"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Default" type="DefaultType" minOccurs="0"/>
			<xs:element name="NamedConstant" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Name">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="ReplaceView" type="xs:boolean"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="Value" type="xs:string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Format" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Multiple formats possible - for user selection</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Printf">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="X64" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="Parameter" minOccurs="0" maxOccurs="unbounded">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="X64" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="Name" type="xs:string">
						<xs:annotation>
							<xs:documentation>e.g. "Hex" or "Dec"</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="Preview" type="xs:string"/>
				</xs:complexType>
			</xs:element>
