	<xs:complexType name="SymbolType">
		<xs:complexContent>
			<xs:extension base="DataTypeType">
				<xs:sequence>
					<xs:element name="PTCID" type="HexDecValue" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Will be calculated automatically if not present with following rule: 0x80000000 + AreaNo shift 24 + ByteOffs or 0xc0000000 + AreaNo shift 24 + BitOffs (only 32 Areas possible)</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="BitOffs" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Will be calculated automatically if not present</xs:documentation>
						</xs:annotation>
