										<xs:enumeration value="RedundancyDst"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:attribute>
							<xs:attribute name="ChildArea" type="xs:boolean">
								<xs:annotation>
									<xs:documentation>Module does not own this area. Will be allocated from a parent module - Child area location will be downloaded with IOFFS_TcIoChildAreaLocation</xs:documentation>
								</xs:annotation>
							</xs:attribute>
							<xs:attribute name="AllowChildAreas" type="xs:boolean">
