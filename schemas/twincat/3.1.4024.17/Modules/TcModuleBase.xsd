									<xs:documentation>default view option for data area views</xs:documentation>
								</xs:annotation>
							</xs:attribute>
							<xs:attribute name="AreaSpan" type="HexDecValue">
								<xs:annotation>
									<xs:documentation>Reserve span of area numbers, default is 1</xs:documentation>
								</xs:annotation>
							</xs:attribute>
							<xs:attribute name="DisableGet" type="xs:boolean">
								<xs:annotation>
									<xs:documentation>Disable set value via ADS symbol</xs:documentation>
								</xs:annotation>
							</xs:attribute>
							<xs:attribute name="DisableSet" type="xs:boolean">
								<xs:annotation>
									<xs:documentation>Disable get value via ADS symbol</xs:documentation>
								</xs:annotation>
							</xs:attribute>
							<xs:attribute name="DynamicArea" type="xs:boolean">
								<xs:annotation>
									<xs:documentation>Content changable</xs:documentation>
								</xs:annotation>
							</xs:attribute>
							<xs:attribute name="OptionalArea" type="xs:boolean">
								<xs:annotation>
									<xs:documentation>Area may enabled or disabled</xs:documentation>
								</xs:annotation>
							</xs:attribute>
							<xs:attribute name="Disabled" type="xs:boolean">
								<xs:annotation>
									<xs:documentation>Optional area disabled</xs:documentation>
								</xs:annotation>
							</xs:attribute>
							<xs:attribute name="FlexibleArea" type="xs:boolean">
								<xs:annotation>
									<xs:documentation>Area content may enabled or disabled</xs:documentation>
								</xs:annotation>
							</xs:attribute>
							<xs:attribute name="AlignmentBits" type="xs:int">
								<xs:annotation>
									<xs:documentation>used if symbol bitOffs not set - 8, 16, 32, 64 possible - 8 is default</xs:documentation>
								</xs:annotation>
							</xs:attribute>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="DisplayName" type="LangTextType" minOccurs="0"/>
			<xs:element name="Comment" type="LangTextType" minOccurs="0"/>
			<xs:element name="ContextId" type="HexDecValue" minOccurs="0"/>
			<xs:element name="ByteSize" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Will be calculated automatically if not present</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="HexDecValue">
							<xs:attribute name="X64" type="HexDecValue"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="Exclude" type="HexDecValue" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>if this area is active exclude areas not selectable</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Symbol" type="SymbolType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Properties" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Property" type="PropertyType" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Relations" type="RelationsType" minOccurs="0"/>
			<xs:element name="Xml" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:any namespace="##any" processContents="skip" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="DisableCodeGeneration" type="xs:boolean"/>
	</xs:complexType>
	<xs:complexType name="DeploymentType">
		<xs:sequence>
			<xs:element name="FileEntry" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Event" minOccurs="0">
