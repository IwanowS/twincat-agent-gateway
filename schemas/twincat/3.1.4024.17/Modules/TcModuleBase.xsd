					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Issuer" type="xs:string" use="required">
					<xs:annotation>
						<xs:documentation>signature relevant</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="TcCert_SignDatabaseKey" type="xs:boolean">
