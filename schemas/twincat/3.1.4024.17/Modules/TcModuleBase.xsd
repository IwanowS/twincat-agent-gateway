						<xs:simpleType>
							<xs:restriction base="xs:NMTOKEN">
								<xs:enumeration value="NoCheck"/>
								<xs:enumeration value="Warning"/>
								<xs:enumeration value="Error"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
					<xs:attribute name="RenameDestination" type="xs:boolean"/>
					<xs:attribute name="EncryptionBehavior">
						<xs:simpleType>
							<xs:restriction base="xs:NMTOKEN">
								<xs:enumeration value="default"/>
								<xs:enumeration value="include"/>
								<xs:enumeration value="exclude"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
			<xs:element name="DependsOn" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:choice>
						<xs:element name="CLSID" type="CLSIDType"/>
						<xs:element name="LibraryId" type="LibraryId">
							<xs:annotation>
								<xs:documentation>'vendor'|'name'|d.d.d.d</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:choice>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
