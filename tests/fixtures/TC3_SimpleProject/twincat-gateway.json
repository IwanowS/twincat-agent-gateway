{
  "schemaVersion": 2,
  "defaultProfile": "fixture",
  "gateway": {
    "pipeName": "TwinCatAgentGateway",
    "processControl": {
      "allowStart": true,
      "allowShutdown": false
    },
    "logging": {
      "retentionDays": 14
    }
  },
  "ui": {
    "mode": "auto"
  },
  "profiles": [
    {
      "name": "fixture",
      "xae": {
        "solution": "TC3_SimpleProject.sln",
        "workspace": {
          "externalChangePolicy": "reloadModified"
        },
        "capabilities": {
          "launch": true,
          "close": false,
          "synchronize": false,
          "discardDirtyDocuments": false,
          "build": true,
          "activate": false
        }
      }
    }
  ]
}
