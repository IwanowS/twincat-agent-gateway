<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Description>Tracked local checkpoint for architecture-v2 XAE build event matching.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EnvDTE" />
    <PackageReference Include="Microsoft.VisualStudio.Interop" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\TwinCatGateway.Contracts\TwinCatGateway.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\src\TwinCatGateway.Xae\XaeBuildEventMatcher.cs"
             Link="Production\XaeBuildEventMatcher.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Xae\XaeProjectBuildRequest.cs"
             Link="Production\XaeProjectBuildRequest.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Xae\XaeDirtyDocumentSet.cs"
             Link="Production\XaeDirtyDocumentSet.cs" />
    <Compile Include="XaeBuildEventLeaseTests.cs"
             Link="Tests\XaeBuildEventLeaseTests.cs" />
  </ItemGroup>
</Project>
