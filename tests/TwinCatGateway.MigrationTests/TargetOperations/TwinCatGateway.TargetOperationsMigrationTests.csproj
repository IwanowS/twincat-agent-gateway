<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsTestProject Condition="'$(TargetFramework)' == 'net8.0'">true</IsTestProject>
    <IsTestProject Condition="'$(TargetFramework)' != 'net8.0'">false</IsTestProject>
    <NoWarn Condition="'$(TargetFramework)' == 'net8.0'">$(NoWarn);CA1510;CA1512;CA1859</NoWarn>
    <Description>Tracked architecture-v2 checkpoint for Target operations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\TwinCatGateway.Contracts\TwinCatGateway.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\src\TwinCatGateway.Core\CapabilityEvaluator.cs"
             Link="Production\CapabilityEvaluator.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\Clock.cs"
             Link="Production\Clock.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\ConfigurationIssue.cs"
             Link="Production\ConfigurationIssue.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\ConfigurationValidationResult.cs"
             Link="Production\ConfigurationValidationResult.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\GatewayConfigurationValidator.cs"
             Link="Production\GatewayConfigurationValidator.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\GatewayOperationException.cs"
             Link="Production\GatewayOperationException.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\GatewayOperationCanceledException.cs"
             Link="Production\GatewayOperationCanceledException.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\OperationCapabilityGuard.cs"
             Link="Production\OperationCapabilityGuard.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\OperatorLockStore.cs"
             Link="Production\OperatorLockStore.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\ProfileResolver.cs"
             Link="Production\ProfileResolver.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\TargetOperationService.cs"
             Link="Production\TargetOperationService.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Compile Include="..\..\TwinCatGateway.UnitTests\TargetOperationServiceTests.cs"
             Link="Tests\TargetOperationServiceTests.cs" />
  </ItemGroup>
</Project>
