<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsTestProject Condition="'$(TargetFramework)' == 'net8.0'">true</IsTestProject>
    <IsTestProject Condition="'$(TargetFramework)' != 'net8.0'">false</IsTestProject>
    <NoWarn Condition="'$(TargetFramework)' == 'net8.0'">$(NoWarn);CA1510</NoWarn>
    <Description>Tracked architecture-v2 IPC and client checkpoint.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\TwinCatGateway.Contracts\TwinCatGateway.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\TwinCatGateway.Core\TwinCatGateway.Core.csproj" />
    <ProjectReference Include="..\..\..\src\TwinCatGateway.Ipc\TwinCatGateway.Ipc.csproj" />
    <Compile Include="..\..\..\src\TwinCatGateway.Desktop\GatewayRequestDispatcher.cs" Link="Production\GatewayRequestDispatcher.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\..\..\src\TwinCatGateway.Client\TwinCatGateway.Client.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Compile Include="IpcV2Tests.cs" />
  </ItemGroup>
</Project>
