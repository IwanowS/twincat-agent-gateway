<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TwinCatGateway.IntegrationTests</AssemblyName>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Description>Tracked local checkpoint for architecture-v2 state observations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageReference Include="Beckhoff.TwinCAT.Ads" Version="7.0.292" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\TwinCatGateway.Ads\TwinCatGateway.Ads.csproj" />
    <ProjectReference Include="..\..\..\src\TwinCatGateway.Contracts\TwinCatGateway.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\src\TwinCatGateway.Core\IGatewayEventSink.cs"
             Link="Production\IGatewayEventSink.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\ProfileObservationStore.cs"
             Link="Production\ProfileObservationStore.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Core\TwinCatRuntimeTargetDiscovery.cs"
             Link="Production\TwinCatRuntimeTargetDiscovery.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Desktop\AdsRuntimeMonitor.cs"
             Link="Production\AdsRuntimeMonitor.cs" />
    <Compile Include="..\..\..\src\TwinCatGateway.Xae\XaeTwinCatSystemStateMapper.cs"
             Link="Production\XaeTwinCatSystemStateMapper.cs" />

    <Compile Include="..\..\TwinCatGateway.IntegrationTests\AdsRuntimeMonitorTests.cs"
             Link="Tests\AdsRuntimeMonitorTests.cs" />
    <Compile Include="..\..\TwinCatGateway.IntegrationTests\AdsRuntimeStatusReaderTests.cs"
             Link="Tests\AdsRuntimeStatusReaderTests.cs" />
    <Compile Include="..\..\TwinCatGateway.IntegrationTests\XaeFactAttribute.cs"
             Link="Tests\XaeFactAttribute.cs" />
    <Compile Include="..\..\TwinCatGateway.IntegrationTests\XaeTwinCatSystemStateMapperTests.cs"
             Link="Tests\XaeTwinCatSystemStateMapperTests.cs" />
    <Compile Include="..\..\TwinCatGateway.UnitTests\ProfileObservationStoreTests.cs"
             Link="Tests\ProfileObservationStoreTests.cs" />
    <Compile Include="..\..\TwinCatGateway.UnitTests\TwinCatRuntimeTargetDiscoveryTests.cs"
             Link="Tests\TwinCatRuntimeTargetDiscoveryTests.cs" />
  </ItemGroup>
</Project>
