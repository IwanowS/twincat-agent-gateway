{
  "schemaVersion": 1,
  "pipeName": "TwinCatAgentGateway",
  "defaultProfile": "default",
  "logRetentionDays": 14,
  "ui": {
    "mode": "auto"
  },
  "agentProcessControl": {
    "allowStart": true,
    "allowShutdown": false
  },
  "profiles": [
    {
      "name": "default",
      "solution": "Machine.sln",
      "allowXaeLaunch": true,
      "allowActivation": false,
      "requireRecentSuccessfulBuild": true,
      "recentBuildMaxAgeSeconds": 600,
      "autoWaitForTcUnit": false
    }
  ]
}
